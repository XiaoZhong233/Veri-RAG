# Required secrets. Replace every placeholder before deployment.
DASHSCOPE_API_KEY=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=24

# Public entry point
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=8088
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# MySQL
MYSQL_DATABASE=veri_rag
MYSQL_USER=veri_rag
MYSQL_PASSWORD=veri_rag_dev
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3307
TZ=Asia/Shanghai

# Redis Stack 7.4 (includes Search, JSON and vector capabilities)
REDIS_PASSWORD=veri_rag_dev
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6380
SPRING_AI_VECTORSTORE_REDIS_INITIALIZE_SCHEMA=true
SPRING_AI_VECTORSTORE_REDIS_INDEX_NAME=veri-rag-index
SPRING_AI_VECTORSTORE_REDIS_PREFIX=veri-rag:embedding:

# Model service
DASHSCOPE_BASE_URL=https://llm-1yauwtsqkmv66e2w.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_CHAT_MODEL=qwen3.7-flash
LLM_TIMEOUT=5m
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024

# Uploads and RAG
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=55MB
RAG_INTENT_CLASSIFIER_ENABLED=true
RAG_INTENT_JAVA_RULES_ENABLED=false
RAG_INTENT_CLASSIFIER_TIMEOUT=15s
RAG_INTENT_CLASSIFIER_MODEL=
RAG_INTENT_CLASSIFIER_THINKING_ENABLED=false
RAG_MANUAL_HISTORY_ENABLED=false
RAG_HISTORY_MAX_MESSAGES=6
RAG_CHUNK_SIZE=500
RAG_MAX_NUM_CHUNKS=10000
RAG_EMBEDDING_BATCH_SIZE=20
RAG_RETRIEVAL_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.75
RAG_ANSWER_CACHE_ENABLED=false
RAG_ANSWER_CACHE_SIMILARITY_THRESHOLD=0.93
RAG_ANSWER_CACHE_TTL_MINUTES=15
RAG_ANSWER_CACHE_MAX_ENTRIES=200
RAG_MEMORY_ENABLED=true
RAG_MEMORY_RECENT_MESSAGES=8
RAG_MEMORY_SUMMARY_TRIGGER_MESSAGES=12

# Observability
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:8088/grafana/
OTLP_BIND_ADDRESS=127.0.0.1
OTLP_HTTP_PORT=4318
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
OTEL_METRICS_EXPORT_STEP=15s
OTEL_TRACING_SAMPLING_PROBABILITY=1.0

# WeCom bot. Disabled by default for Docker deployments.
WECOM_BOT_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_BOT_DISPLAY_NAME=londonist 助手
WECOM_BOT_WEBSOCKET_URL=wss://openws.work.weixin.qq.com
WECOM_BOT_USER_ID=2
WECOM_BOT_HEARTBEAT_INTERVAL=30s
WECOM_BOT_STREAM_UPDATE_INTERVAL=2500ms
