# MySQL
MYSQL_DATABASE=rag
MYSQL_USER=veri_rag
MYSQL_PASSWORD=veri_rag_dev
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_PORT=3306
TZ=Asia/Shanghai

# Redis 8 (includes Search, JSON, and vector capabilities)
REDIS_PASSWORD=veri_rag_dev
REDIS_PORT=6379

# Spring Boot application
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://llm-1yauwtsqkmv66e2w.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_CHAT_MODEL=qwen-flash
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/rag?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=veri_rag
SPRING_DATASOURCE_PASSWORD=veri_rag_dev
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=veri_rag_dev
SPRING_AI_VECTORSTORE_REDIS_INITIALIZE_SCHEMA=true
SPRING_AI_VECTORSTORE_REDIS_INDEX_NAME=veri-rag-index
SPRING_AI_VECTORSTORE_REDIS_PREFIX=veri-rag:embedding:
SERVER_PORT=8081
FILE_UPLOAD_PATH=file
# 单文件/整个 multipart 请求的限制；上传扫描 PDF 时可按服务器内存与 OCR 资源调整。
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=55MB
JWT_SECRET=replace-with-a-long-random-secret-for-non-demo-use
JWT_EXPIRE_HOURS=24
RAG_OCR_ENABLED=true
RAG_OCR_LANGUAGE=chi_sim+eng
RAG_OCR_MIN_CHARS_PER_PAGE=40
RAG_OCR_MAX_PAGES=50
RAG_OCR_DPI=300
RAG_OCR_TIMEOUT_SECONDS=120
RAG_RETRIEVAL_TOP_K=2
RAG_SIMILARITY_THRESHOLD=0.75

# Local observability
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
