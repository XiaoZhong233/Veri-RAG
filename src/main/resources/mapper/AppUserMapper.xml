<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.verirag.mapper.AppUserMapper">

    <sql id="UserColumns">
        id, username, password, real_name, avatar, role, status, create_time
    </sql>

    <select id="findByUsername" resultType="com.example.verirag.entity.AppUser">
        SELECT <include refid="UserColumns" />
        FROM t_user
        WHERE username = #{username}
    </select>
</mapper>
