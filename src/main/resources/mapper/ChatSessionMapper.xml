<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.verirag.mapper.ChatSessionMapper">

    <sql id="SessionColumns">
        id, user_id, title, create_time, update_time
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_chat_session (user_id, title)
        VALUES (#{userId}, #{title})
    </insert>

    <update id="updateTitle">
        UPDATE t_chat_session
        SET title = #{title}
        WHERE id = #{id}
    </update>

    <update id="touchUpdateTime">
        UPDATE t_chat_session
        SET update_time = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <select id="selectById" resultType="com.example.verirag.entity.ChatSession">
        SELECT <include refid="SessionColumns" />
        FROM t_chat_session
        WHERE id = #{id}
    </select>

    <select id="listByUserId" resultType="com.example.verirag.entity.ChatSession">
        SELECT <include refid="SessionColumns" />
        FROM t_chat_session
        WHERE user_id = #{userId}
        ORDER BY create_time DESC, id DESC
    </select>

    <delete id="deleteById">
        DELETE FROM t_chat_session WHERE id = #{id}
    </delete>
</mapper>
